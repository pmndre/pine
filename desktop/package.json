{
  "name": "pine-desktop",
  "productName": "Pine",
  "version": "0.1.0",
  "description": "The desktop app for pine: conversations, code and settings in one window",
  "private": true,
  "type": "module",
  "license": "MIT",
  "main": "dist-electron/main.js",
  "packageManager": "pnpm@12.23.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:preview": "node scripts/preview.ts",
    "dev:preview:home": "node scripts/preview.ts --home '~/.pine'",
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && node scripts/start.mjs",
    "check": "tsc --noEmit",
    "postinstall": "node scripts/ssh2-pure.mjs && node scripts/launch-json.mjs",
    "test": "node scripts/test.mjs --test-force-exit --test-timeout=120000 \"test/*.test.ts\"",
    "pack": "node scripts/pack.mjs",
    "dist": "node scripts/pack.mjs --dist",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@codemirror/commands": "^6.11.2",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.3",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.44.0",
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@lezer/highlight": "^1.2.5",
    "@shadcn/react": "^0.3.1",
    "@storybook/addon-docs": "^10.6.9",
    "@storybook/react-vite": "^10.6.9",
    "@streamdown/code": "^2.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.18.2",
    "@ui-sdk/core": "0.1.0-beta.17",
    "@ui-sdk/react": "0.1.0-beta.17",
    "@vitejs/plugin-react": "^6.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.80.0",
    "motion": "^14.14.0",
    "node-turn": "^0.0.6",
    "playwright-core": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.24.2",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "resedit": "^1.7.2",
    "shadcn": "^4.23.1",
    "shiki": "^4.6.0",
    "storybook": "^10.6.9",
    "streamdown": "^2.8.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "uqr": "^0.1.3",
    "usehooks-ts": "^3.1.1",
    "vite": "^8.3.8",
    "ws": "^8.23.0"
  },
  "dependencies": {
    "bonjour-service": "1.4.4",
    "node-datachannel": "^0.33.6",
    "node-pty": "^1.1.0",
    "ssh2": "^1.17.0"
  }
}
