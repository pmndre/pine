# Dependencies
node_modules/

# Secrets and local configuration. examples/home/.env.example is the template that is kept.
.env
.env.*
!.env.example

# A pine home created inside the checkout for trying things out
/.pine/
/home/

# Databases and what the daemon writes while it runs
*.db
*.db-wal
*.db-shm
*.log
baseline/results/*.log

# Build and tool output
dist/
.gradle/
.kotlin/
coverage/
*.tgz
*.tsbuildinfo

# Editors and operating systems
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# Assistants' local settings. .claude/launch.json is written for each checkout, with its own
# ports (desktop/scripts/launch-json.mjs), so it is not kept either.
**/.claude/*
!.claude/settings.json
!desktop/.claude/skills/

# mattpocock-skills: each contributor's own specs and tickets (docs/agents/issue-tracker.md); no
# trailing slash, so that it also matches .scratch when it is a link (a Claude Code worktree's)
.scratch

# The package made for npm (npm run build)
build/

# Helpers pine builds beside their sources on first use (src/prebuilt.ts)
src/prebuilt/

# The films of pine (reel/): made and kept on the computer that makes them, not in the repository
/reel/
