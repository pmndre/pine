{
  "name": "@pmndre/pine",
  "version": "0.22.2",
  "description": "PI neural engine: an event-driven multi-agent daemon built on the pi coding agent SDK",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pmndre/pine.git"
  },
  "homepage": "https://github.com/pmndre/pine#readme",
  "bugs": {
    "url": "https://github.com/pmndre/pine/issues"
  },
  "bin": {
    "pine": "bin/pine"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/cli.ts start",
    "check": "tsc --noEmit",
    "test": "node --test --test-force-exit \"test/*.test.ts\"",
    "test:live": "node scripts/live.mjs",
    "baseline": "node baseline/run-all.mjs",
    "build": "node scripts/build.mjs",
    "release": "node scripts/release.mjs",
    "desktop": "npm --prefix desktop start",
    "desktop:test": "npm --prefix desktop test",
    "desktop:pack": "npm --prefix desktop run pack"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^1.6.0",
    "@earendil-works/pi-mcp": "^1.6.0",
    "@earendil-works/pi-tui": "^1.6.0",
    "@playwright/mcp": "^0.0.85",
    "@slack/socket-mode": "^3.2.0",
    "@slack/web-api": "^8.4.0",
    "highlight.js": "^10.7.3",
    "marked": "^18.0.11",
    "mqtt": "^5.16.1",
    "typebox": "^1.3.27",
    "undici": "^8.12.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "aedes": "^1.2.0",
    "typescript": "^7.0.2"
  }
}
