{
	"manifest_version": 3,
	"name": "Pine",
	"version": "0.1.1",
	"description": "Lets your pine agents work in this browser: in a tab group of their own, with the tabs you put there.",
	"minimum_chrome_version": "125",
	"key": "",
	"icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
	"action": { "default_title": "Pine", "default_popup": "popup.html", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
	"background": { "service_worker": "background.js" },
	"permissions": ["debugger", "tabs", "tabGroups", "nativeMessaging", "scripting", "storage", "alarms"],
	"host_permissions": ["<all_urls>"]
}
